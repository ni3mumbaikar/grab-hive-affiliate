# General Settings
LOG_LEVEL=INFO
CRON_INTERVAL_HOURS=4.5

# Google Sheets API Integration
GOOGLE_SERVICE_ACCOUNT_JSON=config/service_account.json
SPREADSHEET_ID=your_google_spreadsheet_id_here

# Instagram Integration
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password
INSTAGRAM_SESSION_ID=your_optional_instagram_session_id_cookie_value

# WhatsApp Integration
WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_GROUP_ID=your_whatsapp_group_or_chat_id

# Error Notifications (SMTP)
ADMIN_EMAIL=admin@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
