# General Settings
LOG_LEVEL=INFO
CRON_INTERVAL_HOURS=4.5

# Google Sheets API Integration
GOOGLE_SERVICE_ACCOUNT_JSON=config/service_account.json
SPREADSHEET_ID=your_google_spreadsheet_id_here

# Instagram Integration
# Flag to decide implementation: true for official Graph API, false for unofficial (instagrapi)
INSTAGRAM_USE_OFFICIAL_API=false

# Unofficial Instagram API (instagrapi) Credentials
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password
INSTAGRAM_SESSION_ID=your_optional_instagram_session_id_cookie_value

# Official Instagram Graph API Credentials (used when INSTAGRAM_USE_OFFICIAL_API=true)
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_api_access_token
INSTAGRAM_GRAPH_API_VERSION=v19.0

# WhatsApp Integration
WHATSAPP_API_URL=http://localhost:3000/send-message

# Error Notifications (SMTP)
ADMIN_EMAIL=admin@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
